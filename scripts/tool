#!/usr/bin/env bash
# Run Go or Node from their Docker images; neither is installed on the host.
# Usage: ./scripts/tool go test ./...   |   ./scripts/tool gofmt -l .   |   ./scripts/tool npm ci
# CONTEXIA_TOOL_NETWORK, _ENV (space-separated NAME=value), _IMAGE and _DOCKER are for scripts/verify.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
# One cache for all git worktrees, so a new worktree does not rebuild everything.
cache="$(dirname "$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)")/.cache"
mkdir -p "$cache/go" "$cache/npm"
case "${1:-}" in
  go|gofmt) image="${CONTEXIA_TOOL_IMAGE:-golang:1.24-alpine}" ;;
  node|npm|npx) image=node:22-alpine ;;
  *) echo "usage: scripts/tool go|gofmt|node|npm|npx ..." >&2; exit 2 ;;
esac
args=(--rm -u "$(id -u):$(id -g)" -v "$root":/repo -v "$cache":/cache -w "/repo${TOOL_DIR:+/$TOOL_DIR}"
  -e HOME=/tmp -e CGO_ENABLED=0 -e GOPATH=/cache/go/path -e GOCACHE=/cache/go/build
  -e GOFLAGS=-modcacherw -e npm_config_cache=/cache/npm)
[ -n "${CONTEXIA_TOOL_NETWORK:-}" ] && args+=(--network "$CONTEXIA_TOOL_NETWORK")
for kv in ${CONTEXIA_TOOL_ENV:-}; do args+=(-e "$kv"); done
if [ -n "${CONTEXIA_TOOL_DOCKER:-}" ]; then
  args+=(-v /var/run/docker.sock:/var/run/docker.sock --group-add "$(stat -c %g /var/run/docker.sock)")
fi
exec docker run "${args[@]}" "$image" "$@"
