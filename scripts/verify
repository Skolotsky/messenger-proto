#!/usr/bin/env bash
# The full suite. After the fast check it runs independent lanes side by side, each on
# its own system, database or mock door, and reports every lane, so one run shows every
# failure. No lane depends on another.
# --quick leaves out the lanes with minute-long guardrails (G-012, G-013, G-025, G-026,
# G-027), for use while working. It is not a full verification and must not be reported as one.
set -uo pipefail
quick=0; [ "${1:-}" = "--quick" ] && quick=1
cd "$(dirname "$0")/.." || exit 2
project="contexia-verify-$$"
compose=(docker compose -p "$project" -f deploy/compose.yaml -f deploy/compose.test.yaml)
logs=$(mktemp -d)
cleanup() {
  local pids; pids=$(jobs -p); [ -z "$pids" ] || kill $pids 2>/dev/null
  "${compose[@]}" down -v --remove-orphans >/dev/null 2>&1
  docker compose -p "$project-rebuild" -f deploy/compose.yaml -f deploy/compose.test.yaml down -v --remove-orphans >/dev/null 2>&1
  rm -rf "$logs"
}
trap cleanup EXIT
started=$SECONDS

./scripts/check || { echo "verify: fix ./scripts/check first"; exit 1; }
docker build -q -t contexia-test-tools:1 -f deploy/test-tools.Dockerfile deploy >/dev/null
"${compose[@]}" build --quiet || { echo "verify: FAIL the programs did not build."; exit 1; }
# Built once, before the two browser lanes share it.
CONTEXIA_BUILD_ONLY=1 web/app/scripts/browser-tests > "$logs/web-build" 2>&1 || { tail -n 30 "$logs/web-build"; echo "verify: FAIL the web app did not build."; exit 1; }

# ---- helpers, for the lane on the composed system
gotest() { # module, go test arguments
  local module=$1; shift
  CONTEXIA_TOOL_NETWORK="${project}_default" \
  CONTEXIA_TOOL_ENV="CONTEXIA_PG_HOST=postgres CONTEXIA_PROJECT=$project" \
  CONTEXIA_TOOL_IMAGE=contexia-test-tools:1 CONTEXIA_TOOL_DOCKER=1 \
  TOOL_DIR=$module ./scripts/tool go test -count=1 "$@"
}
mustfail() { # module, tags, test name, package: must FAIL in a test, not merely fail to build
  local out
  out=$(gotest "$1" -tags "$2" -run "$3" "$4" 2>&1)
  if ! grep -q -- '--- FAIL' <<< "$out"; then
    echo "FAIL: $4 did not fail a test with $2, so it cannot be trusted."; tail -5 <<< "$out"; return 1
  fi
  echo "  ok    $4 fails with $2"
}

# ---- the lanes
lane_system() { # the composed system: guardrails, their must-fail builds, integration tests
  "${compose[@]}" up -d --wait --quiet-pull || { "${compose[@]}" ps; "${compose[@]}" logs --tail 30; return 1; }
  local p answer
  for p in conversations delivery feed search sender demo; do
    answer=$("${compose[@]}" exec -T "$p" wget -q -O - http://127.0.0.1:8080/alive)
    case "$answer" in
      *"\"part\":\"$p\""*'"status":"alive"'*) echo "  ok    $p alive" ;;
      *) echo "FAIL: $p answered: $answer"; return 1 ;;
    esac
  done
  local others
  others=$(CONTEXIA_TOOL_IMAGE=contexia-test-tools:1 TOOL_DIR=tests ./scripts/tool go list ./... | grep -v -E 'guardrails/(receivers-independent|orgs-independent|freshness|orgs-apart|two-copies|rebuild)(/|$)|tests/e2e|harness/router' | tr '\n' ' ')
  [ -n "$others" ] || { echo "FAIL: could not list the test packages."; return 1; }
  gotest tests -p 1 $others || return 1
  # Each of these builds has a rule switched off, and its "Fails" tests prove the check notices.
  gotest tests -p 1 -tags standinfaults -run Fails ./guardrails/search-equals-truth/ ./guardrails/notification-once/ ./guardrails/notification-hold/ || return 1
  gotest tests -p 1 -tags deletefaults -run Fails ./guardrails/retire-and-delete/ || return 1
  gotest tests -p 1 -tags agentfaults -run Fails ./guardrails/agent-events/ ./guardrails/reply-in-progress/ ./guardrails/agent-limits/ ./guardrails/idle-organizations-cost-nothing/ || return 1
  gotest tests -p 1 -tags feedfaults -run Fails ./guardrails/feed-equals-replay/ ./guardrails/feed-fence/ ./guardrails/feed-two-copies/ || return 1
  mustfail tests fault_hub_handed TestTwoSaves ./guardrails/live-order/ || return 1
  mustfail tests fault_no_lease_check Frozen ./guardrails/watching-lapses/ || return 1
  mustfail tests fault_no_watch_end Vanished ./guardrails/watching-lapses/ || return 1
  mustfail tests fault_idle_scan TestHousekeeping ./guardrails/idle-organizations-cost-nothing/ || return 1
  mustfail server "integration fault_tick_from_newest" BusyOrganization ./internal/conversations || return 1
  gotest server -tags integration ./...
}
lane_receivers() { tests/e2e/run real -timeout 6m ./guardrails/receivers-independent; }   # G-012, private database
lane_orgs()      { tests/e2e/run real -timeout 6m ./guardrails/orgs-independent; }        # G-026, private database
lane_end_to_end() { tests/e2e/run real -timeout 9m ./e2e/... ./harness/router/ ./guardrails/freshness/ ./guardrails/orgs-apart/ ./guardrails/two-copies/; } # spine, G-013, G-025, G-027
lane_e2e_faults() {                                                                       # the same must fail with a rule off
  tests/e2e/run real -timeout 8m -tags t057faults -run Fails ./guardrails/freshness/ ./guardrails/orgs-apart/ ./guardrails/two-copies/ || return 1
  tests/e2e/run standin -timeout 3m -tags t057faults -run Fails ./e2e/
}
lane_rebuild() {                                                                          # G-020, on its own composed system
  local project="$project-rebuild"
  docker compose -p "$project" -f deploy/compose.yaml -f deploy/compose.test.yaml up -d --wait --quiet-pull || return 1
  gotest tests -p 1 -timeout 6m ./guardrails/rebuild || return 1
  gotest tests -p 1 -timeout 4m -tags demofaults -run Fails ./guardrails/rebuild/
}
# The tests of one width share one mock door, so each half of a width gets its own.
web() { CONTEXIA_SKIP_BUILD=1 web/app/scripts/browser-tests --project="$1" --shard="$2/2" --output="test-results/$1-$2" --reporter=line; }
lane_wide_1()  { web wide 1; }
lane_wide_2()  { web wide 2; }
lane_phone_1() { web phone 1; }
lane_phone_2() { web phone 2; }
lane_outside()   { tests/browser-outside/run --reporter=line; }

lanes=(system rebuild wide_1 wide_2 phone_1 phone_2 outside)
[ "$quick" -eq 1 ] || lanes+=(receivers orgs end_to_end e2e_faults)

echo; echo "Running ${#lanes[@]} lanes side by side: ${lanes[*]}"
for name in "${lanes[@]}"; do
  ( begun=$SECONDS; "lane_$name" > "$logs/$name" 2>&1; code=$?; echo "$code $((SECONDS - begun))" > "$logs/$name.result" ) &
done
wait

failed=0
echo
for name in "${lanes[@]}"; do
  read -r code took < "$logs/$name.result" 2>/dev/null || { code=1; took='?'; }
  if [ "$code" -eq 0 ]; then
    printf '  ok    %-11s %ss  %s\n' "$name" "$took" "$(tr '\r' '\n' < "$logs/$name" | grep -E '^\s+[0-9]+ passed' | tail -1 | sed 's/^ *//')"
  else
    failed=$((failed + 1))
    printf '  FAIL  %-11s %ss\n' "$name" "$took"
  fi
done
for name in "${lanes[@]}"; do
  read -r code _ < "$logs/$name.result" 2>/dev/null || code=1
  if [ "$code" -ne 0 ]; then
    echo; echo "---- $name"
    tr '\r' '\n' < "$logs/$name" | grep -v -E '^\[[0-9]+/[0-9]+\]|\[1A|no test files' | tail -n 45
  fi
done

echo
if [ "$failed" -ne 0 ]; then
  echo "verify: FAIL $failed lane(s). A failing guardrail is a finding: fix the cause, never the test."
  exit 1
fi
if [ "$quick" -eq 1 ]; then
  echo "verify --quick: passed in $((SECONDS - started))s, WITHOUT the timed guardrails G-012, G-013, G-025, G-026 and G-027. Not a full verification."
  exit 0
fi
echo "verify: all passed in $((SECONDS - started))s"
