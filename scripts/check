#!/usr/bin/env bash
# Single entry point for "is the repo healthy?".
# Used by the agent, the git pre-commit hook and, later, CI.
# Add new checks as sections at the bottom: lint, types, tests, guardrail tests.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

failures=0
section() { printf '\n%s\n' "$1"; }
pass() { printf '  ok    %s\n' "$1"; }
fail() { printf '  FAIL  %s\n' "$1"; failures=$((failures + 1)); }

# ---------------------------------------------------------------------------
section "Project context (what every session relies on)"

for f in CLAUDE.md docs/brief.md tasks/board.md tasks/done.md docs/decisions/README.md docs/guardrails.md; do
  if [ -s "$f" ]; then pass "$f present"; else fail "$f is missing or empty"; fi
done

# The brief is the fixed yardstick (G-001). It changes only with the user's approval.
brief_sum="bf6c51f7b6a434d4b84b1a284277e3f52ba485676699e49da08840a8c4c598cb"
if [ "$(sha256sum docs/brief.md 2>/dev/null | cut -d' ' -f1)" = "$brief_sum" ]; then pass "the brief is unchanged"; else fail "docs/brief.md differs from the approved text. Restore it, or with the user's approval update brief_sum in scripts/check"; fi

# The pre-commit hook is switched on in this clone (G-002).
if [ -d .git ] || [ -f .git ]; then
  # Creating a git worktree can rewrite the setting to the absolute path of the same folder.
  hooks_path=$(git config core.hooksPath 2>/dev/null)
  main_hooks="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/.githooks"
  if [ "$hooks_path" = ".githooks" ] || [ "$hooks_path" = "$main_hooks" ]; then pass "pre-commit hook is switched on"; else fail "pre-commit hook is off. Run: git config core.hooksPath .githooks"; fi
fi

# A task lives in exactly one place: the board or the done log.
dupes=$(cat tasks/board.md tasks/done.md 2>/dev/null | grep -oE '\*\*T-[0-9]+\*\*' | sort | uniq -d | tr -d '*' | tr '\n' ' ')
if [ -z "$dupes" ]; then pass "task IDs are unique across board and done log"; else fail "task listed more than once: $dupes"; fi

# Task detail files are reachable from the board or the done log.
orphans=0
for f in tasks/T-*.md; do
  [ -e "$f" ] || continue
  id=$(basename "$f" | grep -oE '^T-[0-9]+')
  if ! grep -qF "**$id**" tasks/board.md tasks/done.md; then fail "$f has no line on the board or in the done log"; orphans=1; fi
done
[ "$orphans" -eq 0 ] && pass "every task file is listed on the board or in the done log"

# Every decision record is in the index, so no decision is invisible to a new session.
unindexed=0
for f in docs/decisions/D-*.md; do
  [ -e "$f" ] || continue
  id=$(basename "$f" | grep -oE '^D-[0-9]+')
  if ! grep -qF "**$id**" docs/decisions/README.md; then fail "$id has a record but no line in docs/decisions/README.md"; unindexed=1; fi
done
[ "$unindexed" -eq 0 ] && pass "every decision record is indexed"

# Every guardrail names its enforcement and has a known status.
bad_rows=$(awk -F'|' '
  /^\| *G-[0-9]+/ {
    id=$2; enforced=$6; status=$7
    gsub(/^ +| +$/, "", id); gsub(/^ +| +$/, "", enforced); gsub(/^ +| +$/, "", status)
    if (status != "enforced" && status != "pending") print id " (status \"" status "\")"
    else if (status == "enforced" && enforced == "") print id " (enforced, but no check named)"
  }' docs/guardrails.md | tr '\n' ' ')
if [ -z "$bad_rows" ]; then pass "every guardrail has a status and a named check"; else fail "guardrail rows need attention: $bad_rows"; fi

# ---------------------------------------------------------------------------
section "Agent tooling"

if [ -f .claude/settings.json ]; then
  if python3 -m json.tool .claude/settings.json >/dev/null 2>&1; then pass ".claude/settings.json is valid JSON"; else fail ".claude/settings.json is not valid JSON (this silently disables every setting in it)"; fi
fi

broken=0
for f in .claude/skills/*/SKILL.md .claude/agents/*.md; do
  [ -e "$f" ] || continue
  if [ "$(head -n 1 "$f")" != "---" ] || ! grep -qE '^description: .+' "$f"; then fail "$f needs frontmatter with a description"; broken=1; fi
done
[ "$broken" -eq 0 ] && pass "skills and agents have frontmatter"

# Visuals must open anywhere: no external scripts or stylesheets.
external=$(grep -liE "(src|href)=[\"']?(https?:)?//|url\\([\"']?(https?:)?//|@import" docs/visuals/*.html 2>/dev/null | tr '\n' ' ')
if [ -z "$external" ]; then pass "visuals are self-contained"; else fail "visuals reference external files (scripts, styles, images, links): $external. Inline them; put source links in the research note instead"; fi

# ---------------------------------------------------------------------------
section "Contracts and guardrails (G-021)"

# Every contract names guardrails that exist; every guardrail comes from an accepted decision.
trace=$(python3 - <<'PY'
import pathlib, re
g = pathlib.Path('docs/guardrails.md').read_text()
rows = {}
for line in g.splitlines():
    m = re.match(r'\|\s*(G-\d+)\s*\|', line)
    if m:
        rows[m.group(1)] = [c.strip() for c in line.strip().strip('|').split('|')]
index = pathlib.Path('docs/decisions/README.md').read_text()
accepted = set(re.findall(r'\*\*(D-\d+)\*\* \[accepted', index))
problems = []
for f in sorted(pathlib.Path('docs/contracts').glob('*.md')):
    if f.name == 'README.md':
        continue
    t = f.read_text()
    part = t.split('## 6. Enforced by')[1] if '## 6. Enforced by' in t else ''
    ids = re.findall(r'G-\d+', part)
    if not ids:
        problems.append(f'{f} names no guardrail under "## 6. Enforced by". Add the G-nnn IDs that hold this contract')
    for i in ids:
        if i not in rows:
            problems.append(f'{f} names {i}, which is not in docs/guardrails.md. Register it there or correct the ID')
for f in sorted(pathlib.Path('docs/contracts').glob('*.md')):
    if f.name != 'README.md':
        t = f.read_text()
        missing = [h for h in ('## 1. Parties', '## 2. ', '## 3. Guarantees', '## 4. Failure behaviour', '## 5. Evolution', '## 6. Enforced by') if h not in t]
        if missing:
            problems.append(f'{f} lacks the part(s) {", ".join(missing)} that docs/contracts/README.md asks for')
for d in sorted(accepted):
    recs = list(pathlib.Path('docs/decisions').glob(d + '-*.md'))
    if recs and not re.search(r'^- Status: accepted', recs[0].read_text(), re.M):
        problems.append(f'{d} is accepted in the index but its record {recs[0]} does not say "Status: accepted". Make them agree')
import json
ask = json.loads(pathlib.Path('.claude/settings.json').read_text()).get('permissions', {}).get('ask', [])
for i, c in rows.items():
    if len(c) > 5 and c[5] == 'enforced':
        for name in re.findall(r'tests/guardrails/([a-z0-9-]+)', c[4]):
            rule = f'Edit(/tests/guardrails/{name}/**)'
            if rule not in ask:
                problems.append(f'{i} is enforced but its test folder is not protected. Add "{rule}" to permissions.ask in .claude/settings.json (G-022)')
for i, c in rows.items():
    src = c[3] if len(c) > 3 else ''
    ds = re.findall(r'D-\d+', src)
    if not ds and 'setup' not in src:
        problems.append(f'{i} names no decision in its "From" column')
    for d in ds:
        if d not in accepted:
            problems.append(f'{i} comes from {d}, which is not accepted in docs/decisions/README.md. A guardrail needs an accepted decision behind it')
print('\n'.join(problems))
PY
)
if [ -z "$trace" ]; then pass "contracts name existing guardrails; guardrails come from accepted decisions"; else while IFS= read -r line; do fail "$line"; done <<< "$trace"; fi

# ---------------------------------------------------------------------------
section "Server (Go, in Docker)"

if ! docker info >/dev/null 2>&1; then
  fail "Docker is not running. Start it: the Go checks run in a container"
else
  unformatted=$(./scripts/tool gofmt -l server tests 2>&1 | grep -v '^\.cache' | tr '\n' ' ')
  if [ -z "$unformatted" ]; then pass "Go code is formatted"; else fail "not formatted: $unformatted. Run: ./scripts/tool gofmt -w server tests"; fi

  for mod in server tests; do
    if out=$(TOOL_DIR=$mod ./scripts/tool go vet ./... 2>&1); then pass "go vet ($mod)"; else fail "go vet ($mod) found problems. Run: TOOL_DIR=$mod ./scripts/tool go vet ./..."; printf '%s\n' "$out" | tail -15; fi
  done

  if out=$(TOOL_DIR=server ./scripts/tool go test ./... 2>&1); then pass "server unit tests, with every contract example against its schema and Go type"; else fail "server unit tests failed. Run: TOOL_DIR=server ./scripts/tool go test ./..."; printf '%s\n' "$out" | tail -25; fi

  if out=$(TOOL_DIR=tests ./scripts/tool go test ./guardrails/conversations-independent/ 2>&1); then pass "the feed's result per conversation does not depend on other conversations (G-030)"; else fail "G-030 failed. A failing guardrail is a finding: fix the rules, not the test. Run: TOOL_DIR=tests ./scripts/tool go test ./guardrails/conversations-independent/"; printf '%s\n' "$out" | tail -25; fi

  section "Contracts in machine form (T-045)"
  if out=$(./scripts/contracts --check 2>&1); then pass "TypeScript types match the schema"; else fail "contracts/generated/types.ts is out of date. Run: ./scripts/contracts"; printf '%s\n' "$out" | tail -5; fi

  section "Web app"
  [ -d web/app/node_modules ] || TOOL_DIR=web/app ./scripts/tool npm ci --no-audit --no-fund >/dev/null 2>&1
  if out=$(TOOL_DIR=web/app ./scripts/tool npm run typecheck 2>&1); then pass "web app types"; else fail "web app types. Run: TOOL_DIR=web/app ./scripts/tool npm run typecheck"; printf '%s\n' "$out" | tail -15; fi
  for page in web/control-panel web/notification-app; do
    [ -d "$page/node_modules" ] || TOOL_DIR=$page ./scripts/tool npm ci --no-audit --no-fund >/dev/null 2>&1
    if out=$(TOOL_DIR=$page ./scripts/tool npm run typecheck 2>&1); then pass "$page types"; else fail "$page types. Run: TOOL_DIR=$page ./scripts/tool npm run typecheck"; printf '%s\n' "$out" | tail -15; fi
  done
fi

# ---------------------------------------------------------------------------
# Later checks are added here. Each calls pass or fail.

printf '\n'
if [ "$failures" -eq 0 ]; then
  echo "check: all passed"
else
  echo "check: $failures failed"
  exit 1
fi
